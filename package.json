{
  "name": "self-host-form",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-Xrab/self-host-form-app.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "cloud-server": "node --watch --env-file=cloud-server/.env cloud-server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "electron .",
    "predist": "node scripts/clear-dev-data.js",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "build": {
    "appId": "com.selfhostform.app",
    "productName": "Self Host Form",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/data/**",
      "package.json",
      "!node_modules/cloudflared/bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
